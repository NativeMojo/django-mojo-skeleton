[Unit]
Description=Pull application config from S3
Documentation=file:/opt/api/aws/config_sync.py

# Needs the network up to reach S3, and must complete BEFORE the app starts so
# a freshly booted node never starts against a missing or stale django.conf.
After=network-online.target
Wants=network-online.target
Before=mojo-asgi.service

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/opt/api/aws/config_sync.py

# An unconfigured box exits 0 (no AWS_CONFIG_BUCKET), so a non-zero status here
# is a real failure. It is NOT fatal to boot on purpose: a node holding a good
# previous config should still come up and serve if S3 is briefly unreachable,
# which is exactly what the script's "keep current config" path preserves.
SuccessExitStatus=0
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
