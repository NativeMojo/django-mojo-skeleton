#!/bin/sh

#-----------------------------------------------------------
# uWSGI Service Manager Script
# This script manages the startup and shutdown of Django and
# WebSocket event services using uWSGI.
#-----------------------------------------------------------

# Ensure the script is run as root
if [ -w / ]; then
    echo "uWSGI Service Manager"
else
    echo "Error: You must run this script as root."
    exit 1
fi

# Set the base directory (parent of the parent directory of the script)
DIR="$(dirname $(dirname $(readlink -f $0)))"

# Configuration variables
DJANGO_WORKERS=8
EVENT_WORKERS=2

# Common paths
VAR_DIR="$DIR/var"
LOG_DIR="$VAR_DIR/logs"

# File paths
DJANGO_RELOAD_FILE="$VAR_DIR/version"
DJANGO_LOG="$LOG_DIR/django.log"
DJANGO_PID="$VAR_DIR/django.pid"

EVENT_RELOAD_FILE="$VAR_DIR/version"
EVENT_LOG="$LOG_DIR/event.log"
EVENT_PID="$VAR_DIR/event.pid"
PROJECT_PATH="$DIR/bin"

# Logging parameters (disabled logging)
LOG_PARAMS="-L"

# uWSGI parameters
DJANGO_PARAMS="--pythonpath=$PROJECT_PATH --socket $VAR_DIR/django.sock \
               --buffer-size=32768 --harakiri=400 --enable-threads \
               --workers=$DJANGO_WORKERS --procname-append='-django' \
               --uid www --gid nginx --chmod-socket=660 \
               --auto-procname --master --module _wsgi \
               --vacuum --touch-reload=$DJANGO_RELOAD_FILE \
               $LOG_PARAMS --pidfile=$DJANGO_PID"

EVENT_PARAMS="--pythonpath=$PROJECT_PATH --die-on-term --reload-mercy 8 \
              --worker-reload-mercy 8 --http-socket $VAR_DIR/event.sock \
              --gevent 1000 --http-websockets --workers=$EVENT_WORKERS \
              --procname-append='-asgi' --auto-procname --master \
              --module _asgi --touch-reload=$EVENT_RELOAD_FILE \
              $LOG_PARAMS --pidfile=$EVENT_PID"

# Ensure 'var' directory exists
if [ ! -d "$VAR_DIR" ]; then
    echo "'var' directory does not exist. Creating..."
    mkdir -p "$VAR_DIR" "$LOG_DIR"
    chown ec2-user:www "$VAR_DIR"
else
    echo "'var' directory exists. Cleaning old logs..."
    rm -f ${DJANGO_LOG}.* ${EVENT_LOG}.*
fi

# Function to check service status
check_status() {
    PID_FILE=$1
    SERVICE_NAME=$2

    if [ -e "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if [ -e "/proc/${PID}/exe" ]; then
            echo "$SERVICE_NAME is RUNNING (PID: $PID)"
            return 0
        else
            echo "$SERVICE_NAME is NOT running"
            return 1
        fi
    else
        echo "$SERVICE_NAME is NOT running"
        return 1
    fi
}

# Function to stop a service if it's running
stop_service() {
    PID_FILE=$1
    SERVICE_NAME=$2

    if [ -e "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if [ -e "/proc/${PID}/exe" ]; then
            echo "Stopping $SERVICE_NAME (PID: $PID)..."
            uwsgi --stop "$PID_FILE"
        else
            echo "$SERVICE_NAME is not running."
        fi
    fi
}

# Function to start a service
start_service() {
    SERVICE_NAME=$1
    PARAMS=$2
    LOG_FILE=$3
    PID_FILE=$4

    echo "Starting $SERVICE_NAME..."
    su -m www -c "uwsgi $PARAMS -d $LOG_FILE" &
    sleep 2

    if [ -e "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if [ -e "/proc/${PID}/exe" ]; then
            echo "$SERVICE_NAME is RUNNING (PID: $PID)."
        else
            echo "FAILED to start $SERVICE_NAME."
            exit 1
        fi
    else
        echo "FAILED to create PID file for $SERVICE_NAME."
        exit 1
    fi
}

case "$1" in
    start)
        start_service "Django Service" "$DJANGO_PARAMS" "$DJANGO_LOG" "$DJANGO_PID"
        # start_service "ASGI Service" "$EVENT_PARAMS" "$EVENT_LOG" "$EVENT_PID"
        ;;
    stop)
        stop_service "$DJANGO_PID" "Django Service"
        # stop_service "$EVENT_PID" "Event Service"
        ;;
    status)
        check_status "$DJANGO_PID" "Django Service"
        # check_status "$EVENT_PID" "Event Service"
        ;;
    *)
        echo "Usage: $0 {start|stop|status}"
        exit 1
        ;;
esac
