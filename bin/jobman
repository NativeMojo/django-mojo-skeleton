#!/usr/bin/env bash
# Thin launcher for the packaged job manager.
#
# The logic lives in django-mojo (`mojo.deploy.jobman`), which every node
# reinstalls on every deploy — so a fix reaches a project born from this
# skeleton without that project re-copying anything. Keep this file a
# launcher: the argv surface and the exit code pass straight through, and
# /etc/cron.d/3_mojo_jobs plus aws/update.sh both call it by this path.
#
#   ./bin/jobman start|stop|status [engine|scheduler]
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export DJANGO_SETTINGS_MODULE=settings
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES
exec python3 -m mojo.deploy.jobman --root "$ROOT" "$@"
