#!/usr/bin/env bash
set -euo pipefail

# Project root = directory of this script's parent
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

# Environment
export DJANGO_SETTINGS_MODULE=settings
export OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES  # macOS fork-safety workaround

# Paths
BIN_JOBS="./bin/jobs.py"
LOG_DIR="$PROJECT_ROOT/var/logs"
PID_DIR="$PROJECT_ROOT/var/pids"
ENGINE_LOG="$LOG_DIR/job_engine.log"
SCHED_LOG="$LOG_DIR/job_scheduler.log"
ENGINE_PID="$PID_DIR/job_engine.pid"
SCHED_PID="$PID_DIR/job_scheduler.pid"

mkdir -p "$LOG_DIR" "$PID_DIR"

is_running() {
  local pidfile="$1"
  [[ -f "$pidfile" ]] && ps -p "$(cat "$pidfile")" >/dev/null 2>&1
}

matching_jobs_pids() {
  local comp="$1"
  local pattern="bin/jobs\.py ${comp} foreground"
  pgrep -f -- "$pattern" || true
}

start_one() {
  local comp="$1"
  local pidfile logfile name
  if [[ "$comp" == "engine" ]]; then
    pidfile="$ENGINE_PID"; logfile="$ENGINE_LOG"; name="Engine"
  elif [[ "$comp" == "scheduler" ]]; then
    pidfile="$SCHED_PID"; logfile="$SCHED_LOG"; name="Scheduler"
  else
    echo "Unknown component: $comp" >&2
    return 1
  fi

  if is_running "$pidfile"; then
    echo "$name already running (PID $(cat "$pidfile"))"
    return 0
  fi

  existing="$(matching_jobs_pids "$comp" | tr '\n' ' ' | sed 's/ $//')"
  if [[ -n "${existing}" ]]; then
    echo "$name appears to be running already (detected PIDs: ${existing}). Refusing to start another."
    echo "If this is stale, run './bin/jobman stop $comp' first."
    return 0
  fi

  if [[ "$comp" == "engine" ]]; then
    echo "Starting engine (foreground mode, backgrounded by shell)..."
    nohup "$BIN_JOBS" engine foreground >> "$logfile" 2>&1 &
    echo $! > "$pidfile"
    echo "Engine PID: $(cat "$pidfile"), log: $logfile"
  else
    echo "Starting scheduler (foreground mode, backgrounded by shell)..."
    nohup "$BIN_JOBS" scheduler foreground >> "$logfile" 2>&1 &
    echo $! > "$pidfile"
    echo "Scheduler PID: $(cat "$pidfile"), log: $logfile"
  fi
}

stop_one() {
  local comp="$1"
  local pidfile name
  if [[ "$comp" == "engine" ]]; then
    pidfile="$ENGINE_PID"; name="Engine"
  elif [[ "$comp" == "scheduler" ]]; then
    pidfile="$SCHED_PID"; name="Scheduler"
  else
    echo "Unknown component: $comp" >&2
    return 1
  fi

  local pids=""
  if [[ -f "$pidfile" ]]; then
    local pid
    pid="$(cat "$pidfile" || true)"
    if [[ -n "${pid:-}" ]] && ps -p "$pid" >/dev/null 2>&1; then
      pids="$pid"
    fi
  fi

  local matches
  matches="$(matching_jobs_pids "$comp" || true)"
  if [[ -n "$matches" ]]; then
    pids="$(printf "%s\n%s\n" "$pids" "$matches" | sed '/^$/d' | sort -u | tr '\n' ' ')"
    pids="${pids% }"
  fi

  if [[ -z "${pids:-}" ]]; then
    if [[ -f "$pidfile" ]]; then
      echo "$name not running (stale PID file), cleaning up"
      rm -f "$pidfile"
    else
      echo "$name not running"
    fi
    return 0
  fi

  echo "Stopping $name (PIDs: $pids)..."
  kill -TERM $pids 2>/dev/null || true

  for _ in {1..10}; do
    local alive=""
    for p in $pids; do
      if ps -p "$p" >/dev/null 2>&1; then
        alive="yes"; break
      fi
    done
    [[ -z "$alive" ]] && break
    sleep 1
  done

  local remaining=""
  for p in $pids; do
    ps -p "$p" >/dev/null 2>&1 && remaining="$remaining $p"
  done
  remaining="${remaining# }"
  if [[ -n "$remaining" ]]; then
    echo "Force killing $name (PIDs: $remaining)..."
    kill -KILL $remaining 2>/dev/null || true
  fi

  if [[ -f "$pidfile" ]]; then
    local curpid
    curpid="$(cat "$pidfile" || true)"
    if [[ -z "${curpid:-}" ]] || ! ps -p "$curpid" >/dev/null 2>&1; then
      rm -f "$pidfile"
    fi
  fi
  echo "$name stopped"
}

status_one() {
  local comp="$1"
  local pidfile name
  if [[ "$comp" == "engine" ]]; then
    pidfile="$ENGINE_PID"; name="Engine"
  elif [[ "$comp" == "scheduler" ]]; then
    pidfile="$SCHED_PID"; name="Scheduler"
  else
    echo "Unknown component: $comp" >&2
    return 1
  fi

  local matches pid managed others p
  matches="$(matching_jobs_pids "$comp")"

  managed=""
  if [[ -f "$pidfile" ]]; then
    pid="$(cat "$pidfile" || true)"
    if [[ -n "$pid" ]] && ps -p "$pid" >/dev/null 2>&1; then
      managed="$pid"
      echo "$name running (PID $pid)"
    else
      echo "$name not running (stale PID file: $pidfile)"
    fi
  else
    echo "$name not running"
  fi

  others=""
  for p in $matches; do
    if [[ -n "$managed" && "$p" == "$managed" ]]; then
      continue
    fi
    others="$others $p"
  done
  others="${others# }"

  if [[ -n "$others" ]]; then
    if [[ -n "$managed" ]]; then
      echo "$name extra instances detected: $others"
    else
      echo "$name unmanaged instances detected: $others"
    fi
  fi
}

usage() {
  cat <<EOF
Usage:
  ./bin/jobman start [engine|scheduler]
  ./bin/jobman stop  [engine|scheduler]
  ./bin/jobman status [engine|scheduler]

Examples:
  ./bin/jobman start             # start engine & scheduler
  ./bin/jobman stop              # stop engine & scheduler
  ./bin/jobman status            # show both
  ./bin/jobman stop engine       # stop only engine

Status lines:
  "extra instances detected"     more than the one instance jobman manages
  "unmanaged instances detected" a jobs.py process runs but no live pidfile
Note: the scan covers foreground-mode processes only; daemon-mode engines
(bin/jobs.py engine start, own pidfile) are outside jobman's management.
EOF
}

cmd="${1:-}"
target="${2:-}"

case "$cmd" in
  start)
    if [[ -z "$target" ]]; then
      start_one engine
      start_one scheduler
    else
      start_one "$target"
    fi
    ;;
  stop)
    if [[ -z "$target" ]]; then
      stop_one engine
      stop_one scheduler
    else
      stop_one "$target"
    fi
    ;;
  status)
    if [[ -z "$target" ]]; then
      status_one engine
      status_one scheduler
    else
      status_one "$target"
    fi
    ;;
  *)
    usage
    exit 1
    ;;
esac
