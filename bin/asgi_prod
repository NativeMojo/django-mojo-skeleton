#!/bin/sh
#-----------------------------------------------------------
# Uvicorn (ASGI) Service Manager Script
# Mirrors django_prod but for ASGI using uvicorn
#
# Features:
# - Run as root and drop privileges to 'www' user
# - Writes PID to var/asgi.pid
# - Logs to var/logs/asgi.log
# - Defaults to Unix domain socket at var/asgi.sock (like uWSGI)
# - start | stop | status | restart commands
#
# Configuration via environment variables:
# - ASGI_WORKERS: number of worker processes (default: 8)
# - LOG_LEVEL: uvicorn log level (default: info)
# - FORWARDED_ALLOW_IPS: comma-separated list of IPs (default: *)
# - TIMEOUT_KEEP_ALIVE: keep-alive timeout seconds (default: 75)
# - GRACEFUL_TIMEOUT: graceful shutdown timeout seconds (default: 8)
# - ASGI_BIND:
#     - If empty (default), bind to Unix socket: var/asgi.sock
#     - If "unix:/path/to.sock" or "/path/to.sock": bind to that UDS
#     - If "host:port": bind TCP to host/port
#     - If "port": bind TCP to 0.0.0.0:port
# - DJANGO_SETTINGS_MODULE: defaults to "settings"
#
# Examples:
#   ./bin/asgi_prod start
#   ASGI_WORKERS=12 LOG_LEVEL=warning ./bin/asgi_prod restart
#   ASGI_BIND=0.0.0.0:9009 ./bin/asgi_prod start
#   ASGI_BIND=unix:/run/mojo/asgi.sock ./bin/asgi_prod start
#-----------------------------------------------------------

# Ensure the script is run as root (same style as django_prod)
if [ -w / ]; then
    echo "Uvicorn ASGI Service Manager"
else
    echo "Error: You must run this script as root."
    exit 1
fi

# Resolve project root (parent of this script's directory)
DIR="$(cd "$(dirname "$0")"/.. && pwd)"

# Common paths
VAR_DIR="$DIR/var"
LOG_DIR="$VAR_DIR/logs"
ASGI_LOG="$LOG_DIR/asgi.log"
ASGI_PID="$VAR_DIR/asgi.pid"
ASGI_SOCKET="$VAR_DIR/asgi.sock"
ASGI_APP_DIR="$DIR/bin"
ASGI_APP="_asgi:application"

# Configurable parameters
ASGI_WORKERS="${ASGI_WORKERS:-8}"
LOG_LEVEL="${LOG_LEVEL:-info}"
FORWARDED_ALLOW_IPS="${FORWARDED_ALLOW_IPS:-*}"
TIMEOUT_KEEP_ALIVE="${TIMEOUT_KEEP_ALIVE:-75}"
GRACEFUL_TIMEOUT="${GRACEFUL_TIMEOUT:-8}"
ASGI_BIND="${ASGI_BIND:-}"

# Django environment
export DJANGO_SETTINGS_MODULE="${DJANGO_SETTINGS_MODULE:-settings}"
export PYTHONUNBUFFERED=1

# Ensure 'var' directory exists
if [ ! -d "$VAR_DIR" ]; then
    echo "'var' directory does not exist. Creating..."
    mkdir -p "$LOG_DIR"
    # Mirror ownership style used in django_prod (ignore failures if users/groups don't exist)
    chown ec2-user:www "$VAR_DIR" 2>/dev/null || true
    chmod 775 "$VAR_DIR" 2>/dev/null || true
else
    echo "'var' directory exists. Cleaning old logs..."
    rm -f ${ASGI_LOG}.* 2>/dev/null || true
fi

# Build bind args based on ASGI_BIND
BIND_ARGS="--uds $ASGI_SOCKET"
if [ -n "$ASGI_BIND" ]; then
    case "$ASGI_BIND" in
        unix:*)
            BIND_ARGS="--uds ${ASGI_BIND#unix:}"
            ;;
        *.sock)
            BIND_ARGS="--uds $ASGI_BIND"
            ;;
        *:*)
            HOST="$(echo "$ASGI_BIND" | cut -d: -f1)"
            PORT="$(echo "$ASGI_BIND" | cut -d: -f2)"
            BIND_ARGS="--host $HOST --port $PORT"
            ;;
        *)
            # If just a port number is provided
            BIND_ARGS="--host 0.0.0.0 --port $ASGI_BIND"
            ;;
    esac
fi

# Helper: command existence check
have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

# Discover running uvicorn PIDs even if PID file is missing
find_pids() {
    PIDS=""
    # Prefer socket-based discovery
    if [ -S "$ASGI_SOCKET" ]; then
        if have_cmd fuser; then
            # fuser prints PIDs; suppress errors and normalize whitespace
            PIDS="$(fuser "$ASGI_SOCKET" 2>/dev/null | tr ' ' '\n' | tr -cd '0-9 \n')"
        fi
        if [ -z "$PIDS" ] && have_cmd lsof; then
            PIDS="$(lsof -t "$ASGI_SOCKET" 2>/dev/null)"
        fi
    fi
    # Fallback: pattern match uvicorn command line
    if [ -z "$PIDS" ] && have_cmd pgrep; then
        PIDS="$(pgrep -f "uvicorn .*${ASGI_APP}.*")"
        if [ -z "$PIDS" ]; then
            PIDS="$(pgrep -f "uvicorn .*(--app-dir[ =]${ASGI_APP_DIR}|${ASGI_APP_DIR}).*")"
        fi
    fi
    echo "$PIDS"
}

# Helper: check service status
check_status() {
    if [ -e "$ASGI_PID" ]; then
        PID="$(cat "$ASGI_PID" 2>/dev/null)"
        if [ -n "$PID" ] && [ -e "/proc/${PID}/exe" ]; then
            echo "ASGI Service is RUNNING (PID: $PID)"
            return 0
        fi
        # Fall through to discovery if PID file is stale
        echo "ASGI PID file exists but process not found. Attempting discovery..."
    fi

    PIDS="$(find_pids | tr '\n' ' ')"
    if [ -n "$PIDS" ]; then
        echo "ASGI Service appears RUNNING (external) PIDs: $PIDS"
        return 0
    fi

    echo "ASGI Service is NOT running"
    return 1
}

# Helper: stop service
stop_service() {
    TARGET_PIDS=""

    if [ -e "$ASGI_PID" ]; then
        PID="$(cat "$ASGI_PID" 2>/dev/null)"
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            TARGET_PIDS="$PID"
        fi
    fi

    if [ -z "$TARGET_PIDS" ]; then
        TARGET_PIDS="$(find_pids | tr '\n' ' ')"
    fi

    if [ -n "$TARGET_PIDS" ]; then
        echo "Stopping ASGI Service (PIDs: $TARGET_PIDS)..."
        for PID in $TARGET_PIDS; do
            kill "$PID" 2>/dev/null || true
        done
        # Wait up to 3 seconds for graceful exit
        i=0
        while : ; do
            ALIVE=0
            for PID in $TARGET_PIDS; do
                if kill -0 "$PID" 2>/dev/null; then
                    ALIVE=1
                    break
                fi
            done
            if [ $ALIVE -eq 0 ]; then
                break
            fi
            i=$((i+1))
            if [ $i -ge 3 ]; then
                echo "Force killing ASGI Service (PIDs: $TARGET_PIDS)..."
                for PID in $TARGET_PIDS; do
                    kill -9 "$PID" 2>/dev/null || true
                done
                break
            fi
            sleep 1
        done
        rm -f "$ASGI_PID"
    else
        echo "ASGI PID file not found and no matching processes discovered."
    fi
}

# Helper: start service
start_service() {
    # If already running, short-circuit
    if [ -e "$ASGI_PID" ]; then
        PID="$(cat "$ASGI_PID" 2>/dev/null)"
        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            echo "ASGI Service is already RUNNING (PID: $PID)."
            return 0
        fi
    fi

    echo "Starting ASGI Service..."
    # Run as 'www' user (same pattern as django_prod)
    # Use nohup and background, capture the uvicorn master PID from the subshell
    PID="$(su -m www -c "sh -lc 'nohup uvicorn $ASGI_APP --app-dir \"$ASGI_APP_DIR\" $BIND_ARGS --workers $ASGI_WORKERS --proxy-headers --forwarded-allow-ips \"$FORWARDED_ALLOW_IPS\" --timeout-keep-alive $TIMEOUT_KEEP_ALIVE --log-level \"$LOG_LEVEL\" >> \"$ASGI_LOG\" 2>&1 & echo \\$!'" 2>/dev/null)"

    if [ -z "$PID" ]; then
        echo "FAILED to start ASGI Service (no PID returned)."
        exit 1
    fi

    echo "$PID" > "$ASGI_PID"
    sleep 1

    if kill -0 "$PID" 2>/dev/null; then
        echo "ASGI Service is RUNNING (PID: $PID)."
    else
        echo "FAILED to start ASGI Service."
        rm -f "$ASGI_PID"
        exit 1
    fi
}

case "${1:-}" in
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    restart|reload)
        stop_service
        start_service
        ;;
    status)
        check_status
        ;;
    *)
        echo "Usage: $0 {start|stop|status|restart}"
        echo ""
        echo "Environment overrides:"
        echo "  ASGI_WORKERS=8 LOG_LEVEL=info FORWARDED_ALLOW_IPS='*'"
        echo "  TIMEOUT_KEEP_ALIVE=75"
        echo "  ASGI_BIND='' (default UDS at $ASGI_SOCKET)"
        echo "     Examples:"
        echo "       ASGI_BIND=unix:/run/mojo/asgi.sock"
        echo "       ASGI_BIND=/tmp/asgi.sock"
        echo "       ASGI_BIND=0.0.0.0:9009"
        echo "       ASGI_BIND=9009"
        exit 1
        ;;
esac
